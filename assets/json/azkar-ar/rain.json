      "category_id": "rain",
      "text": "اللَّهُمَّ صَيِّبًا نَافِعًا",
      "repeat": 1,
      "virtue": "رواه البخاري",
      "transliteration": "allahumma sayyiban nafian",
      "translation": "O Allah, make it beneficial rain."
    },
    {
      "id": 10,
      "category_id": "rain",
      "text": "مُطِرْنَا بِفَضْلِ اللَّهِ وَرَحْمَتِهِ",
      "repeat": 1,
      "virtue": "متفق عليه",
      "transliteration": "mutirna bi-fadlillahi wa rahmatih",
      "translation": "We have been given rain by the grace and mercy of Allah."

    {
      "id": 11,
      "category_id": "rain",
      "text": "اللَّهُمَّ صَيِّبًا هَنِيئًا",
      "repeat": 1,
      "virtue": "دعاء عند المطر",
      "transliteration": "allahumma sayyiban hanian",
      "translation": "O Allah, make it pleasant and beneficial rain."
